<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Todo List</title>
</head>
<body>
    <div>
        <h1>Todo-list</h1>
        <form action="/addtodo" method="post">
            <input name="title" type="text" placeholder="Title">
            <input name="description" type="text" placeholder="Description">
            <button type="submit">Add</button>
        </form>
        
    </div>
      <% alltodo.forEach(element => { %>
         <p><%= element.title %></p>
         <p><%= element.description %></p>
         <form action="/delete/<%= element._id %>" method="post">
            <button type="submit">Delete</button>
        </form>
        <form action="/edittodo/<%= element._id %>" method="get">
            <button type="submit">Edit</button>
        </form>
        <form action="/todocompleted/<%= element._id %>" method="post">
            <input type="checkbox"  <%= element.completed ?  "checked" : "" %> onchange="this.form.submit()"/>
        </form>
      <% }) %>
</body>
</html>